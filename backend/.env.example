# ─────────────────────────────────────────────
# Braq Uni – Braq Connect™ API
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# ── Required in production ────────────────────────────────────────────────────
# With NODE_ENV=production the API and worker refuse to start unless every variable
# marked [required] is set to a real value (placeholders like "your_…" are refused):
# DATABASE_URL, META_APP_SECRET, META_WHATSAPP_TOKEN, META_PHONE_NUMBER_ID,
# META_WEBHOOK_VERIFY_TOKEN, JWT_SECRET (32+ chars), GEMINI_API_KEY, RESEND_API_KEY,
# DASHBOARD_BASE_URL — and database TLS must be verified (DB_SSL_MODE=verify + DB_SSL_CA).

# Server
NODE_ENV=development
PORT=3000
API_BASE_URL=https://your-api-domain.com

# PostgreSQL (Supabase)
# Copy the transaction pooler connection string from:
# Project Settings → Database → Connection string → Transaction pooler (port 6543)
# URL-encode any special chars in your password (e.g. @ → %40)
# Append ?family=4 to force IPv4 and avoid timeout issues
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-1-xx-region.pooler.supabase.com:6543/postgres?family=4
# Direct / session connection (port 5432, not the transaction pooler) for the job
# worker's LISTEN/NOTIFY and the migration runner's advisory lock. Optional: without
# it the worker polls and migrations use DATABASE_URL.
# DATABASE_DIRECT_URL=postgresql://postgres.your-project-ref:your-password@aws-1-xx-region.pooler.supabase.com:5432/postgres?family=4

# Database TLS. verify (default in production) checks the server certificate against
# DB_SSL_CA; no-verify (default elsewhere) encrypts without checking — refused in
# production; disable = no TLS (local Postgres only). Do not put sslmode=… in the URL:
# ssl* URL parameters are ignored so this setting is the single source of truth.
# Supabase CA: Project Settings → Database → SSL configuration → Download certificate.
# DB_SSL_MODE=verify
# DB_SSL_CA=/etc/secrets/supabase-ca.crt        # a file path, or the PEM text itself
# DB_CONNECT_TIMEOUT_MS=15000
# DB_STATEMENT_TIMEOUT_MS=120000

# Meta Cloud API (WhatsApp)
META_APP_ID=your_meta_app_id
# [required] verifies X-Hub-Signature-256 on every webhook (unsigned webhooks are refused in production)
META_APP_SECRET=your_meta_app_secret
META_PHONE_NUMBER_ID=your_phone_number_id
META_WHATSAPP_TOKEN=your_permanent_access_token
META_WEBHOOK_VERIFY_TOKEN=your_random_verify_token_string
META_API_VERSION=v20.0

# JWT Auth (Staff Dashboard)
# [required] at least 32 random characters, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=8h

# Gemini API (AI-grounded FAQ + quotation parsing) — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key

# Resend (Consultant Email Notifications)
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key
# Once braquni.com is verified at resend.com/domains, use:
FROM_EMAIL=notifications@braquni.com
# Temporary override: set this to YOUR email to receive all notifications while domain is unverified
# NOTIFICATION_OVERRIDE_EMAIL=your@email.com
DASHBOARD_BASE_URL=https://your-dashboard-domain.com
# Production CORS allow-list (comma-separated). Defaults to DASHBOARD_BASE_URL.
# CORS_ORIGINS=https://your-dashboard-domain.com
# Set to 1 when running behind a reverse proxy / load balancer so rate limits use the real client IP
# TRUST_PROXY=1

# Job worker (Postgres queue). Runs inside the API by default; set
# WORKER_IN_PROCESS=false and run `npm run worker` to scale it separately.
# WORKER_IN_PROCESS=true
# WORKER_POLL_MS=1000
# WORKER_CONCURRENCY=4
# JOB_BACKOFF_BASE_MS=5000
# BROADCAST_RATE_PER_SEC=20
# AI_TIMEOUT_MS=20000
# On SIGTERM (deploy) running jobs get this long to finish; keep below the platform's kill grace period.
# WORKER_DRAIN_MS=25000

# WhatsApp templates for messages sent more than 24 h after the client's last message
# (see README "WhatsApp message templates"). Without them those messages are NOT delivered.
# WHATSAPP_TEMPLATES={"order_stage":"braq_order_stage","payment_received":"braq_payment_received","proof_ready":"braq_proof_ready","ticket_resolved":"braq_ticket_resolved","quote_ready":"braq_quote_ready","quote_expiring":"braq_quote_expiring","consultant_reply":"braq_consultant_reply","order_delay":"braq_order_delay"}
# WHATSAPP_WINDOW_CHECK=off   # tests only — refused in production

# First admin (npm run seed). Against production a real password is required.
# SEED_ADMIN_NAME=Admin
# SEED_ADMIN_EMAIL=admin@your-domain.com
# SEED_ADMIN_PASSWORD=a-long-unique-passphrase

# Logging
LOG_LEVEL=info
