{
  "name": "@braquni/api",
  "version": "1.0.0",
  "private": true,
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "worker": "node src/worker.js",
    "build": "echo 'no build step required'",
    "migrate": "node src/db/migrate.js",
    "db:reset": "node src/db/reset.js --yes-wipe-everything",
    "seed": "node src/db/seed.js",
    "seed:catalog": "node src/db/seed-catalog.js",
    "seed:testing": "node src/db/seed-testing.js",
    "backfill": "node src/db/backfill-needs-review.js",
    "test": "node --test --experimental-test-module-mocks \"src/**/*.test.js\" \"tests/unit/**/*.test.js\"",
    "test:integration": "node --test --test-force-exit --test-concurrency=3 --test-timeout=600000 \"tests/integration/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-module-mocks --experimental-test-coverage --test-coverage-include=\"src/**\" \"src/**/*.test.js\" \"tests/unit/**/*.test.js\"",
    "test:blackbox": "node --test --test-force-exit --test-concurrency=4 --test-timeout=600000 \"tests/blackbox/*.test.js\""
  },
  "dependencies": {
    "@google/genai": "^0.3.0",
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.0",
    "pdfkit": "^0.15.0",
    "pg": "^8.12.0",
    "resend": "^6.17.1",
    "uuid": "^10.0.0",
    "winston": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "embedded-postgres": "^18.4.0-beta.17",
    "nock": "^14.0.17",
    "nodemon": "^3.1.4",
    "selfsigned": "^5.5.0",
    "supertest": "^7.3.1"
  }
}
